{
  "name": "nextjs-supabase-ai-template-front",
  "version": "1.0.0",
  "description": "Next.js Supabase frontend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:port": "next dev -p ${FRONTEND_PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "start:port": "next start -p ${FRONTEND_PORT:-3000}",
    "lint": "next lint",
    "index:codebase": "node ./scripts/generate-codebase-index.mjs",
    "index:check": "node -e \"const fs=require('node:fs');const p='.agents/codebase-index.md';if(!fs.existsSync(p)||!fs.readFileSync(p,'utf8').trim()){console.error(p+' is missing or empty');process.exit(1)}console.log(p+' exists and is not empty')\"",
    "setup": "cd .. && npm run setup"
  },
  "dependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^3.3.1",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@mui/material-nextjs": "^6.1.9",
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.38.0",
    "next": "^14.2.13",
    "nodemailer": "^8.0.7",
    "notistack": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.47.0",
    "react-phone-number-input": "^3.4.16",
    "yup": "^1.3.2"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.50.0",
    "eslint-config-next": "^14.2.13",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "6.0.3"
  }
}
