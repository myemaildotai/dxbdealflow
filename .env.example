# Frontend
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WHATSAPP_PREFIX=https://wa.me/

# Server routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications
# Gmail requires an App Password, not your normal Gmail password.
# Business mail can use its own SMTP host, port, username, password, and secure setting.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="DXB Deal Flow <your-email@gmail.com>"
CRON_SECRET=replace-with-a-long-random-cron-secret
